# my-tes3mp settings.
#
# Copy this file to .env and edit it:
#
#     cp .env.example .env
#
# Every setting is optional; the values below are the defaults. After a change
# run `./my-tes3mp host` (or `docker compose up -d`) to apply it.
#
# Syntax: KEY=value, one per line, no spaces around '='. Spaces inside a value
# are fine. Put a comment on its own line, not after a value. If a value
# contains $ or # or starts with a quote, wrap it in single quotes:
#
#     TES3MP_PASSWORD='pa$$word #1'
#
# .env may hold the server password - it is git-ignored, keep it that way.

# ---- Server -------------------------------------------------------------------

# Name shown to players and, if listed publicly, in the server browser.
TES3MP_SERVER_NAME=my-tes3mp

# UDP port on the host that players connect to. Open or forward this port
# (UDP, not TCP) in your firewall or router. Inside the container the server
# always uses 25565.
TES3MP_PORT=25565

# Maximum number of players connected at the same time (1-9999).
TES3MP_MAX_PLAYERS=16

# Password players must enter to join. Empty means anyone who can reach the
# port can join. Whitespace at either end is ignored.
TES3MP_PASSWORD=

# How much the server logs: 0 verbose (very noisy), 1 info, 2 warnings,
# 3 errors, 4 fatal errors only. Read the log with `./my-tes3mp logs`.
TES3MP_LOG_LEVEL=1

# true  = announce the server to the public TES3MP master server so that it
#         shows up in everyone's server browser.
# false = private: only people who know the address can find it.
# If you list publicly, keep TES3MP_PORT=25565: the master server lists the
# port it sees the server's announcements come from, and that is the server's
# own port 25565, not TES3MP_PORT.
TES3MP_MASTER_ENABLED=false

# How much of a character's progress is shared between players.
#   separate = nothing is: each player has his own journal and quests, faction
#              ranks and reputation, dialogue topics, bounty, map and kill
#              counts. Two people can play two unrelated careers - different
#              Great Houses included - on one server.
#   shared   = party style (stock TES3MP): quests, faction ranks and kills
#              progress for everybody at once.
#   custom   = neither; whatever scripts/config.lua on the server says.
# Inventories, skills, levels and gold are always each player's own. The world
# itself (who is alive, what is in a chest) is always one world for everyone.
TES3MP_PROGRESSION=separate

# true = every player can build his own Great House stronghold. Without it the
# game only lets the first one finish, and a build stalls when its owner logs
# out. Details: docker/custom/myTes3mp/strongholds.lua.
TES3MP_STRONGHOLD_HELPER=true

# The world heals: this many real hours after a cell (a room, a dungeon level,
# a patch of wilderness) is first visited, and once nobody is in it, it is put
# back the way the game shipped - its people alive again, its loot back. That
# is what lets a second player do a quest the first one already did. 0 = never.
#
# Never reset: the Great House strongholds, and any cell where a player has
# put items into a container (for as long as something is still in there).
# Items left lying on the floor elsewhere do disappear with a reset.
# In game, /resetinfo tells you what will happen to the cell you are in.
TES3MP_CELL_RESET_HOURS=4

# More places that must never reset: cell names, or parts of names, separated
# by semicolons. Example: Balmora, Caius Cosades' House; Vivec, Arena
TES3MP_CELL_RESET_KEEP=

# How many real minutes one in-game day lasts. Stock TES3MP takes about 45.
# 0 = leave the world's time scale alone (change it in game with /settimescale).
TES3MP_DAY_MINUTES=10

# true = everybody on the server is allied automatically: stray hits between
# you are not held against anyone, you do not break each other's sneaking, and
# kills made together count for both of you.
TES3MP_PARTY=true

# How much tougher the world is than in the original game: off, normal, hard
# or brutal. Enemies get more health - more still as the highest-level player
# online levels up - and each player takes more and deals a little less damage
# as his own level rises. "hard" is meant for two people fighting side by side.
TES3MP_CHALLENGE=hard

# Merchants. Their gold is back this many real minutes after it was last
# refilled, and their wares this many seconds after they were last put in
# order (things you sold them are gone again by then). 0 = leave that part to
# the original game, where gold takes 24 in-game hours and most wares never
# come back.
TES3MP_VENDOR_GOLD_MINUTES=1
TES3MP_VENDOR_STOCK_SECONDS=15

# true = each artifact and unique item can be taken from its original place
# once per player. The world brings them back for the next player, but nobody
# can collect the same one twice. /uniques in game lists what you have claimed.
TES3MP_UNIQUE_CLAIMS=true

# After someone claims a unique item that another player has not had yet, its
# cell resets after this many real minutes instead of the usual hours.
# 0 = no hurry.
TES3MP_UNIQUE_RESPAWN_MINUTES=30

# Docker image to run. By default it is built locally from docker/Dockerfile
# on first start. To use a published image instead, set it here and fetch it
# with `docker compose pull` before starting.
# TES3MP_IMAGE=my-tes3mp-server:0.8.1

# ---- Client (local play) ------------------------------------------------------

# Path to the "Data Files" folder of your own Morrowind installation (the one
# containing Morrowind.esm). Only needed to play from this machine, and only
# if it is not found automatically. Not used by the server.
# MORROWIND_DATA=/path/to/Morrowind/Data Files
